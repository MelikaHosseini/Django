    if request.method == 'POST':
            form = new_userMassagesForm(request.POST)

            if form.is_valid():
                new_user_message = form.save(commit=False)
                new_user_message.new_user = new_user
                new_user_message.created_by = request.user
                new_user_message.save()

                new_user.save()

